+			#clock-cells = <0>;
+			clock-output-names = "hfpll_l2";
+			clocks = <&xo_board>;
+			clock-names = "xo";
+		};
+
+		hfpll0: clock-controller@f908a000 {
+			compatible = "qcom,msm8974-hfpll";
+			reg = <0xf908a000 0x30>;
+			#clock-cells = <0>;
