+	/*
+	 * Outside soc: the Krait clock controller has no registers of its own
+	 * (the muxes are reached through the L2 indirect interface), so it
+	 * cannot sit on the simple-bus.
+	 */
+	kraitcc: clock-controller {
+		compatible = "qcom,krait-cc-v2";
+		clocks = <&hfpll0>, <&hfpll1>, <&hfpll2>, <&hfpll3>,
+			 <&hfpll_l2>;
+		clock-names = "hfpll0", "hfpll1", "hfpll2", "hfpll3",
+			      "hfpll_l2";
+		#clock-cells = <1>;
+	};
+
 	soc: soc {
 		#address-cells = <1>;
 		#size-cells = <1>;
@@ -387,6 +415,18 @@
 		saw_l2: power-manager@f9012000 {
 			compatible = "qcom,msm8974-saw2-v2.1-l2", "qcom,saw2";
 			reg = <0xf9012000 0x1000>;
+
+			/*
+			 * The shared Krait supply: ganged PM8841 FTS phases that
+			 * this SAW drives as APCS master. Every core runs from it
+			 * with its per-core LDO bypassed (BHS), so it must never
+			 * be switched off.
+			 */
+			saw_l2_vreg: regulator {
+				regulator-min-microvolt = <700000>;
+				regulator-max-microvolt = <1120000>;
+				regulator-always-on;
+			};
 		};
 
 		watchdog@f9017000 {
@@ -496,6 +536,52 @@
 			reg = <0xf90b9000 0x1000>, <0xf9009000 0x1000>;
 		};
 
