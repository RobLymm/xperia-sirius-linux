-	__iowrite32_copy(addr, drv->reg_data->seq,
-			ARRAY_SIZE(drv->reg_data->seq) / 4);
+	/*
+	 * Write the SPM sequences first.. A SAW without a sequence table (the
+	 * MSM8974 L2 APCS master) must not have zeroes written over its
