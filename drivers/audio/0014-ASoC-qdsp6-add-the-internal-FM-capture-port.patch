From: Rob Watson <rob@mediaeden.com>
Subject: [PATCH] ASoC: qdsp6: add the internal FM capture port

msm8974-era LPASS has an internal FM I2S port, AFE port 0x3005, that an FM
tuner can feed directly. On the Sony Xperia Z2 the Broadcom BCM4335C0 sends
its FM audio there, and Sony's stock Android routes it with
"MultiMedia1 Mixer INTERNAL_FM_TX". Mainline q6afe has no internal FM port,
so FM audio cannot reach the DSP.

Add INT_FM_TX as a capture port:

- dt-bindings: INT_FM_TX = 137
- q6afe: port 0x3005 with AFE_PARAM_ID_INTERNAL_BT_FM_CONFIG (0x00010211),
  whose payload is minor version, channel count, bit width and sample rate,
  and q6afe_int_fm_port_prepare()
- q6dsp-lpass-ports: an "Internal FM Capture" DAI, 48 kHz S16_LE, 1-2 ch
- q6afe-dai: hw_params, prepare, DAPM widget and route for the port
- q6routing: an INT_FM_TX input on each MultiMedia capture mixer

Applies on top of the aport's 0007 (both LPAIF clocks). Built with clang
against the running v6.16.12-msm8974 config; symbol CRCs agree with the
installed modules except q6dsp_audio_ports_set_config, whose config struct
gains an ops pointer.

Not yet verified to carry audio.

---
diff -ruN a/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h b/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
--- a/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h	2026-09-13 09:39:44.920321875 +0100
+++ b/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h	2026-09-13 09:41:06.506550002 +0100
@@ -140,6 +140,7 @@
 #define DISPLAY_PORT_RX_6	134
 #define DISPLAY_PORT_RX_7	135
 #define USB_RX			136
+#define INT_FM_TX		137
 
 #define LPASS_CLK_ID_PRI_MI2S_IBIT	1
 #define LPASS_CLK_ID_PRI_MI2S_EBIT	2
diff -ruN a/sound/soc/qcom/qdsp6/q6afe.c b/sound/soc/qcom/qdsp6/q6afe.c
--- a/sound/soc/qcom/qdsp6/q6afe.c	2026-09-13 09:41:06.373106382 +0100
+++ b/sound/soc/qcom/qdsp6/q6afe.c	2026-09-13 09:41:06.517096694 +0100
@@ -43,6 +43,8 @@
 
 #define AFE_PARAM_ID_SLIMBUS_CONFIG    0x00010212
 #define AFE_PARAM_ID_I2S_CONFIG	0x0001020D
+#define AFE_PARAM_ID_INTERNAL_BT_FM_CONFIG	0x00010211
+#define AFE_API_VERSION_INTERNAL_BT_FM_CONFIG	0x1
 #define AFE_PARAM_ID_TDM_CONFIG	0x0001029D
 #define AFE_PARAM_ID_PORT_SLOT_MAPPING_CONFIG	0x00010297
 #define AFE_PARAM_ID_CODEC_DMA_CONFIG	0x000102B8
@@ -128,6 +130,8 @@
 #define AFE_PORT_ID_TERTIARY_MI2S_TX        0x1005
 #define AFE_PORT_ID_QUATERNARY_MI2S_RX      0x1006
 #define AFE_PORT_ID_QUATERNARY_MI2S_TX      0x1007
+/* Internal FM Tx port: audio from an FM tuner wired to LPASS. */
+#define AFE_PORT_ID_INTERNAL_FM_TX          0x3005
 #define AFE_PORT_ID_QUINARY_MI2S_RX	    0x1016
 #define AFE_PORT_ID_QUINARY_MI2S_TX	    0x1017
 
@@ -416,6 +420,13 @@
 	u32 mem_map_handle;
 } __packed;
 
+struct afe_param_id_internal_bt_fm_cfg {
+	u32 bt_fm_cfg_minor_version;
+	u16 num_channels;
+	u16 bit_width;
+	u32 sample_rate;
+} __packed;
+
 struct afe_param_id_hdmi_multi_chan_audio_cfg {
 	u32 hdmi_cfg_minor_version;
 	u16 datatype;
@@ -611,6 +622,7 @@
 	struct afe_param_id_tdm_cfg	tdm_cfg;
 	struct afe_param_id_cdc_dma_cfg	dma_cfg;
 	struct afe_param_id_usb_cfg usb_cfg;
+	struct afe_param_id_internal_bt_fm_cfg int_bt_fm_cfg;
 } __packed;
 
 
@@ -930,6 +942,7 @@
 	[RX_CODEC_DMA_RX_7] = { AFE_PORT_ID_RX_CODEC_DMA_RX_7,
 				RX_CODEC_DMA_RX_7, 1, 1},
 	[USB_RX] = { AFE_PORT_ID_USB_RX, USB_RX, 1, 1},
+	[INT_FM_TX] = { AFE_PORT_ID_INTERNAL_FM_TX, INT_FM_TX, 0, 1},
 };
 
 static void q6afe_port_free(struct kref *ref)
@@ -1500,6 +1513,25 @@
  * @cfg: HDMI configuration for the afe port
  *
  */
+/**
+ * q6afe_int_fm_port_prepare() - Prepare the internal FM afe port.
+ *
+ * @port: Instance of afe port
+ * @cfg: sample format of the FM audio arriving on the port
+ */
+void q6afe_int_fm_port_prepare(struct q6afe_port *port,
+			       struct q6afe_int_fm_cfg *cfg)
+{
+	union afe_port_config *pcfg = &port->port_cfg;
+
+	pcfg->int_bt_fm_cfg.bt_fm_cfg_minor_version =
+					AFE_API_VERSION_INTERNAL_BT_FM_CONFIG;
+	pcfg->int_bt_fm_cfg.num_channels = cfg->num_channels;
+	pcfg->int_bt_fm_cfg.bit_width = cfg->bit_width;
+	pcfg->int_bt_fm_cfg.sample_rate = cfg->sample_rate;
+}
+EXPORT_SYMBOL_GPL(q6afe_int_fm_port_prepare);
+
 void q6afe_hdmi_port_prepare(struct q6afe_port *port,
 			     struct q6afe_hdmi_cfg *cfg)
 {
@@ -1819,6 +1851,9 @@
 	case AFE_PORT_ID_USB_RX:
 		cfg_type = AFE_PARAM_ID_USB_AUDIO_CONFIG;
 		break;
+	case AFE_PORT_ID_INTERNAL_FM_TX:
+		cfg_type = AFE_PARAM_ID_INTERNAL_BT_FM_CONFIG;
+		break;
 	default:
 		dev_err(dev, "Invalid port id 0x%x\n", port_id);
 		return ERR_PTR(-EINVAL);
diff -ruN a/sound/soc/qcom/qdsp6/q6afe-dai.c b/sound/soc/qcom/qdsp6/q6afe-dai.c
--- a/sound/soc/qcom/qdsp6/q6afe-dai.c	2026-09-13 09:39:45.066844238 +0100
+++ b/sound/soc/qcom/qdsp6/q6afe-dai.c	2026-09-13 09:41:06.521724659 +0100
@@ -92,6 +92,20 @@
 	return 0;
 }
 
+static int q6int_fm_hw_params(struct snd_pcm_substream *substream,
+			      struct snd_pcm_hw_params *params,
+			      struct snd_soc_dai *dai)
+{
+	struct q6afe_dai_data *dai_data = dev_get_drvdata(dai->dev);
+	struct q6afe_int_fm_cfg *fm = &dai_data->port_config[dai->id].int_fm;
+
+	fm->sample_rate = params_rate(params);
+	fm->bit_width = 16;
+	fm->num_channels = params_channels(params);
+
+	return 0;
+}
+
 static int q6afe_usb_hw_params(struct snd_pcm_substream *substream,
 			       struct snd_pcm_hw_params *params,
 			       struct snd_soc_dai *dai)
@@ -431,6 +445,10 @@
 		q6afe_usb_port_prepare(dai_data->port[dai->id],
 				       &dai_data->port_config[dai->id].usb_audio);
 		break;
+	case INT_FM_TX:
+		q6afe_int_fm_port_prepare(dai_data->port[dai->id],
+					  &dai_data->port_config[dai->id].int_fm);
+		break;
 	default:
 		return -EINVAL;
 	}
@@ -635,6 +653,7 @@
 	{"PRI_MI2S_TX", NULL, "Primary MI2S Capture"},
 	{"SEC_MI2S_TX", NULL, "Secondary MI2S Capture"},
 	{"QUAT_MI2S_TX", NULL, "Quaternary MI2S Capture"},
+	{"INT_FM_TX", NULL, "Internal FM Capture"},
 	{"QUIN_MI2S_TX", NULL, "Quinary MI2S Capture"},
 
 	{"WSA_CODEC_DMA_RX_0 Playback", NULL, "WSA_CODEC_DMA_RX_0"},
@@ -706,6 +725,14 @@
 	 */
 };
 
+static const struct snd_soc_dai_ops q6int_fm_ops = {
+	.probe			= msm_dai_q6_dai_probe,
+	.remove			= msm_dai_q6_dai_remove,
+	.prepare		= q6afe_dai_prepare,
+	.hw_params		= q6int_fm_hw_params,
+	.shutdown		= q6afe_dai_shutdown,
+};
+
 static const struct snd_soc_dai_ops q6hdmi_ops = {
 	.probe			= msm_dai_q6_dai_probe,
 	.remove			= msm_dai_q6_dai_remove,
@@ -1006,6 +1033,7 @@
 		0, SND_SOC_NOPM, 0, 0),
 
 	SND_SOC_DAPM_AIF_IN("USB_RX", NULL, 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_AIF_OUT("INT_FM_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
 };
 
 static const struct snd_soc_component_driver q6afe_dai_component = {
@@ -1121,6 +1149,7 @@
 	cfg.q6tdm_ops = &q6tdm_ops;
 	cfg.q6dma_ops = &q6dma_ops;
 	cfg.q6usb_ops = &q6afe_usb_ops;
+	cfg.q6int_fm_ops = &q6int_fm_ops;
 	dais = q6dsp_audio_ports_set_config(dev, &cfg, &num_dais);
 
 	return devm_snd_soc_register_component(dev, &q6afe_dai_component, dais, num_dais);
diff -ruN a/sound/soc/qcom/qdsp6/q6afe.h b/sound/soc/qcom/qdsp6/q6afe.h
--- a/sound/soc/qcom/qdsp6/q6afe.h	2026-09-13 09:39:44.970843928 +0100
+++ b/sound/soc/qcom/qdsp6/q6afe.h	2026-09-13 09:41:06.508859790 +0100
@@ -3,7 +3,7 @@
 #ifndef __Q6AFE_H__
 #define __Q6AFE_H__
 
-#define AFE_PORT_MAX		137
+#define AFE_PORT_MAX		138
 
 #define MSM_AFE_PORT_TYPE_RX 0
 #define MSM_AFE_PORT_TYPE_TX 1
@@ -234,6 +234,12 @@
 	u16	num_channels;
 };
 
+struct q6afe_int_fm_cfg {
+	u32	sample_rate;
+	u16	bit_width;
+	u16	num_channels;
+};
+
 struct q6afe_port_config {
 	struct q6afe_hdmi_cfg hdmi;
 	struct q6afe_slim_cfg slim;
@@ -241,6 +247,7 @@
 	struct q6afe_tdm_cfg tdm;
 	struct q6afe_cdc_dma_cfg dma_cfg;
 	struct q6afe_usb_cfg usb_audio;
+	struct q6afe_int_fm_cfg int_fm;
 };
 
 struct q6afe_port;
@@ -252,6 +259,8 @@
 int q6afe_get_port_id(int index);
 void q6afe_usb_port_prepare(struct q6afe_port *port,
 			    struct q6afe_usb_cfg *cfg);
+void q6afe_int_fm_port_prepare(struct q6afe_port *port,
+			       struct q6afe_int_fm_cfg *cfg);
 void q6afe_hdmi_port_prepare(struct q6afe_port *port,
 			    struct q6afe_hdmi_cfg *cfg);
 void q6afe_slim_port_prepare(struct q6afe_port *port,
diff -ruN a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c
--- a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c	2026-09-13 09:39:45.133281645 +0100
+++ b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c	2026-09-13 09:41:06.518616619 +0100
@@ -594,6 +594,19 @@
 	Q6AFE_CDC_DMA_TX_DAI(TX_CODEC_DMA_TX_5),
 	Q6AFE_CDC_DMA_RX_DAI(RX_CODEC_DMA_RX_6),
 	Q6AFE_CDC_DMA_RX_DAI(RX_CODEC_DMA_RX_7),
+	{
+		.capture = {
+			.stream_name = "Internal FM Capture",
+			.rates = SNDRV_PCM_RATE_48000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE,
+			.channels_min = 1,
+			.channels_max = 2,
+			.rate_min = 48000,
+			.rate_max = 48000,
+		},
+		.id = INT_FM_TX,
+		.name = "INT_FM_TX",
+	},
 };
 
 int q6dsp_audio_ports_of_xlate_dai_name(struct snd_soc_component *component,
@@ -647,6 +660,9 @@
 		case USB_RX:
 			q6dsp_audio_fe_dais[i].ops = cfg->q6usb_ops;
 			break;
+		case INT_FM_TX:
+			q6dsp_audio_fe_dais[i].ops = cfg->q6int_fm_ops;
+			break;
 		default:
 			break;
 		}
diff -ruN a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h
--- a/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h	2026-09-13 09:39:45.182554794 +0100
+++ b/sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h	2026-09-13 09:41:06.517553955 +0100
@@ -12,6 +12,7 @@
 	const struct snd_soc_dai_ops *q6tdm_ops;
 	const struct snd_soc_dai_ops *q6dma_ops;
 	const struct snd_soc_dai_ops *q6usb_ops;
+	const struct snd_soc_dai_ops *q6int_fm_ops;
 };
 
 struct snd_soc_dai_driver *q6dsp_audio_ports_set_config(struct device *dev,
diff -ruN a/sound/soc/qcom/qdsp6/q6routing.c b/sound/soc/qcom/qdsp6/q6routing.c
--- a/sound/soc/qcom/qdsp6/q6routing.c	2026-09-13 09:39:45.240844799 +0100
+++ b/sound/soc/qcom/qdsp6/q6routing.c	2026-09-13 09:41:06.522865713 +0100
@@ -70,6 +70,7 @@
 	{ mix_name, "QUIN_MI2S_TX", "QUIN_MI2S_TX" },	\
 	{ mix_name, "TERT_MI2S_TX", "TERT_MI2S_TX" },		\
 	{ mix_name, "SLIMBUS_0_TX", "SLIMBUS_0_TX" },		\
+	{ mix_name, "INT_FM_TX", "INT_FM_TX" },			\
 	{ mix_name, "SLIMBUS_1_TX", "SLIMBUS_1_TX" },		\
 	{ mix_name, "SLIMBUS_2_TX", "SLIMBUS_2_TX" },		\
 	{ mix_name, "SLIMBUS_3_TX", "SLIMBUS_3_TX" },		\
@@ -148,6 +149,9 @@
 	SOC_SINGLE_EXT("SLIMBUS_0_TX", SLIMBUS_0_TX,			\
 		id, 1, 0, msm_routing_get_audio_mixer,			\
 		msm_routing_put_audio_mixer),				\
