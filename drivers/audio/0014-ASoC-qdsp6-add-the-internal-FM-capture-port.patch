+		msm_routing_put_audio_mixer),				\
 	SOC_SINGLE_EXT("SLIMBUS_1_TX", SLIMBUS_1_TX,			\
 		id, 1, 0, msm_routing_get_audio_mixer,			\
 		msm_routing_put_audio_mixer),				\
