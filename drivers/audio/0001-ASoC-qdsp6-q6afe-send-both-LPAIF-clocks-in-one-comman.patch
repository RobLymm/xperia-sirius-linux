From: Rob Watson <rob@mediaeden.com>
Subject: [PATCH] ASoC: qdsp6: q6afe: send both LPAIF clocks in one command

A clock configuration command carries both an LPAIF clock values field pair
and a mode saying which of them the DSP should apply.
q6afe_port_set_sysclk()
handles LPAIF_BIT_CLK and LPAIF_OSR_CLK in separate cases, each sending its
own command with the single-clock mode, so the second command supersedes
the
first and only one clock is left running.

A port that needs both, such as MI2S on msm8974 driving an external codec,
therefore never starts. The failure is quiet: every AFE command returns
success and the stream simply stalls with no data moving.

Remember each clock as it is set and send both together once both are
known,
using the both-valid mode. Ports that only ever set one of the two keep the
single-clock mode they used before, so existing platforms are unaffected.

Found while bringing up audio on the Sony Xperia Z2 (msm8974pro), where the
Quaternary MI2S port needs a 1.536 MHz bit clock and a 12.288 MHz
oversampling clock at the same time.

---
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -360,6 +360,7 @@
 
 #define Q6AFE_LPASS_MODE_CLK1_VALID 1
 #define Q6AFE_LPASS_MODE_CLK2_VALID 2
+#define Q6AFE_LPASS_MODE_BOTH_VALID 3
 #define Q6AFE_LPASS_CLK_SRC_INTERNAL 1
 #define Q6AFE_LPASS_CLK_ROOT_DEFAULT 0
 #define AFE_API_VERSION_TDM_CONFIG              1
@@ -641,6 +642,8 @@
 	struct q6afe *afe;
 	struct kref refcount;
 	struct list_head node;
+	u32 lpaif_bit_clk;
+	u32 lpaif_osr_clk;
 };
 
 struct afe_cmd_remote_lpass_core_hw_vote_request {
@@ -1233,20 +1236,37 @@
 		ret = q6afe_set_digital_codec_core_clock(port, &dcfg);
 		break;
 	case LPAIF_BIT_CLK:
-		ccfg.i2s_cfg_minor_version = AFE_API_VERSION_I2S_CONFIG;
-		ccfg.clk_val1 = freq;
-		ccfg.clk_src = clk_src;
-		ccfg.clk_root = clk_root;
-		ccfg.clk_set_mode = Q6AFE_LPASS_MODE_CLK1_VALID;
-		ret = q6afe_port_set_lpass_clock(port, &ccfg);
-		break;
-
 	case LPAIF_OSR_CLK:
+		/*
+		 * A clock config command carries both clock values and a mode
+		 * saying which of them to apply. Sending the bit clock and the
+		 * oversampling clock in two commands therefore leaves only the
+		 * one named by the second command running, and a port that
+		 * needs both never starts: every command still succeeds and
+		 * the stream simply stalls.
+		 *
+		 * Remember each value as it is set and send both together once
+		 * both are known. Ports that only ever set one clock keep the
+		 * single-clock mode they had before.
+		 */
+		if (clk_id == LPAIF_BIT_CLK)
+			port->lpaif_bit_clk = freq;
+		else
+			port->lpaif_osr_clk = freq;
+
 		ccfg.i2s_cfg_minor_version = AFE_API_VERSION_I2S_CONFIG;
-		ccfg.clk_val2 = freq;
+		ccfg.clk_val1 = port->lpaif_bit_clk;
+		ccfg.clk_val2 = port->lpaif_osr_clk;
 		ccfg.clk_src = clk_src;
 		ccfg.clk_root = clk_root;
-		ccfg.clk_set_mode = Q6AFE_LPASS_MODE_CLK2_VALID;
+
+		if (port->lpaif_bit_clk && port->lpaif_osr_clk)
+			ccfg.clk_set_mode = Q6AFE_LPASS_MODE_BOTH_VALID;
+		else if (port->lpaif_osr_clk)
+			ccfg.clk_set_mode = Q6AFE_LPASS_MODE_CLK2_VALID;
+		else
+			ccfg.clk_set_mode = Q6AFE_LPASS_MODE_CLK1_VALID;
+
 		ret = q6afe_port_set_lpass_clock(port, &ccfg);
 		break;
 	case Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT ... Q6AFE_LPASS_CLK_ID_QUI_MI2S_OSR:
