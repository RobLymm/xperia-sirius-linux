		spmi@fc4cf000 {
			compatible = "qcom,spmi-pmic-arb";
			reg-names = "core", "intr", "cnfg";
			reg = <0xfc4cf000 0x1000 0xfc4cb000 0x1000 0xfc4ca000 0x1000>;
			interrupt-names = "periph_irq";
			interrupts = <0x00 0xbe 0x04>;
			qcom,ee = <0x00>;
			qcom,channel = <0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			pm8841@4 {
				compatible = "qcom,pm8841", "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				mpps@a000 {
					compatible = "qcom,pm8841-mpp", "qcom,spmi-mpp";
					reg = <0xa000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x98 0x00 0x00 0x04>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x98>;
				};

				temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x04 0x24 0x00 0x01>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0xb9>;
				};
			};

			pm8841@5 {
				compatible = "qcom,pm8841", "qcom,spmi-pmic";
				reg = <0x05 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
			};

			pm8941@0 {
				compatible = "qcom,pm8941", "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				rtc@6000 {
					compatible = "qcom,pm8941-rtc";
					reg = <0x6000 0x6100>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x61 0x01 0x01>;
				};

				pon@800 {
					compatible = "qcom,pm8941-pon";
					reg = <0x800>;

					pwrkey {
						compatible = "qcom,pm8941-pwrkey";
						interrupts = <0x00 0x08 0x00 0x03>;
						debounce = <0x3d09>;
						bias-pull-up;
					};

					resin {
						compatible = "qcom,pm8941-resin";
						interrupts = <0x00 0x08 0x01 0x03>;
						debounce = <0x3d09>;
						bias-pull-up;
						status = "disabled";
					};
				};

				usb-detect@900 {
					compatible = "qcom,pm8941-misc";
					reg = <0x900>;
					interrupts = <0x00 0x09 0x00 0x03>;
					interrupt-names = "usb_id";
					phandle = <0x40>;
				};

				charger@1000 {
					compatible = "qcom,pm8941-charger";
					reg = <0x1000>;
					interrupts = <0x00 0x10 0x07 0x03 0x00 0x10 0x05 0x03 0x00 0x10 0x04 0x03 0x00 0x12 0x01 0x03 0x00 0x12 0x00 0x03 0x00 0x13 0x02 0x03 0x00 0x13 0x01 0x03 0x00 0x14 0x01 0x03>;
					interrupt-names = "chg-done", "chg-fast", "chg-trkl", "bat-temp-ok", "bat-present", "chg-gone", "usb-valid", "dc-valid";
					usb-otg-in-supply = <0x99>;
					status = "okay";
					usb-charge-current-limit = <0x16e360>;
					qcom,fast-charge-safe-current = <0x2dc6c0>;
					qcom,fast-charge-current-limit = <0x20ce70>;
					qcom,fast-charge-safe-voltage = <0x432380>;
					qcom,fast-charge-high-threshold-voltage = <0x426030>;
					qcom,auto-recharge-threshold-voltage = <0x414ec0>;
					qcom,minimum-input-voltage = <0x401640>;
					phandle = <0x3f>;

					otg-vbus {
						phandle = <0x41>;
					};
				};

				gpio@c000 {
					compatible = "qcom,pm8941-gpio", "qcom,spmi-gpio";
					reg = <0xc000>;
					gpio-controller;
					gpio-ranges = <0x9a 0x00 0x00 0x24>;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x9a>;

					boost-bypass-state {
						pins = "gpio21";
						function = "normal";
						phandle = <0xbd>;
					};

					gpio-keys-active-state {
						pins = "gpio2", "gpio3", "gpio4", "gpio5";
						function = "normal";
						bias-pull-up;
						power-source = <0x02>;
						phandle = <0xbb>;
					};

					wl-sleep-clk-state {
						pins = "gpio17";
						function = "func2";
						output-high;
						power-source = <0x02>;
						phandle = <0x22>;
					};

					wl-reg-active-state {
						pins = "gpio18";
						function = "normal";
						bias-disable;
						power-source = <0x02>;
						phandle = <0xbe>;
					};

					lcd-dcdc-en-active-state {
						pins = "gpio20";
						function = "normal";
						bias-disable;
						power-source = <0x02>;
						input-disable;
						output-low;
						phandle = <0xbc>;
					};

					bt-reg-on-state {
						pins = "gpio16";
						function = "normal";
						output-low;
						power-source = <0x02>;
						phandle = <0xbf>;
					};

					lcd-reset-state {
						pins = "gpio19";
						function = "normal";
						bias-disable;
						power-source = <0x02>;
						input-disable;
						output-high;
						phandle = <0xc6>;
					};
				};

				mpps@a000 {
					compatible = "qcom,pm8941-mpp", "qcom,spmi-mpp";
					reg = <0xa000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x9b 0x00 0x00 0x08>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x9b>;
				};

				temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x00 0x24 0x00 0x01>;
					io-channels = <0x9c 0x08>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					phandle = <0xba>;
				};

				adc@3100 {
					compatible = "qcom,spmi-vadc";
					reg = <0x3100>;
					interrupts = <0x00 0x31 0x00 0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#io-channel-cells = <0x01>;
					phandle = <0x9c>;

					channel@6 {
						reg = <0x06>;
					};

					channel@8 {
						reg = <0x08>;
					};

					channel@9 {
						reg = <0x09>;
					};

					channel@a {
						reg = <0x0a>;
					};

					channel@e {
						reg = <0x0e>;
					};

					channel@f {
						reg = <0x0f>;
					};

					channel@30 {
						reg = <0x30>;
					};
				};

				adc@3600 {
					compatible = "qcom,pm8941-iadc", "qcom,spmi-iadc";
					reg = <0x3600>;
					interrupts = <0x00 0x36 0x00 0x01>;
					qcom,external-resistor-micro-ohms = <0x2710>;
				};

				charger@2800 {
					compatible = "qcom,pm8941-coincell";
					reg = <0x2800>;
					status = "okay";
					qcom,rset-ohms = <0x834>;
					qcom,vset-millivolts = <0xbb8>;
				};
			};

			pm8941@1 {
				compatible = "qcom,pm8941", "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pwm {
					compatible = "qcom,pm8941-lpg";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					status = "okay";
					qcom,power-source = <0x01>;

					multi-led {
						color = <0x09>;
						function = "status";
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						led@5 {
							reg = <0x05>;
							color = <0x03>;
						};

						led@6 {
							reg = <0x06>;
							color = <0x02>;
						};

						led@7 {
							reg = <0x07>;
							color = <0x01>;
						};
					};
				};

				vibrator@c000 {
					compatible = "qcom,pm8916-vib";
					reg = <0xc000>;
					status = "okay";
				};

				wled@d800 {
					compatible = "qcom,pm8941-wled";
					reg = <0xd800>;
					label = "backlight";
					status = "okay";
					qcom,cs-out;
					qcom,current-limit = <0x14>;
					qcom,current-boost-limit = <0x325>;
					qcom,switching-freq = <0x640>;
					qcom,ovp = <0x1d>;
					qcom,num-strings = <0x02>;
					phandle = <0xc5>;
				};

				regulators {
					compatible = "qcom,pm8941-regulators";
					interrupts = <0x01 0x83 0x02 0x00 0x01 0x84 0x02 0x00>;
					interrupt-names = "ocp-5vs1", "ocp-5vs2";
					vin_5vs-supply = <0x9d>;

					s4 {
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x4c4b40>;
						regulator-enable-ramp-delay = <0x1f4>;
						phandle = <0x9d>;
					};

					5vs1 {
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-pull-down;
						regulator-over-current-protection;
						qcom,ocp-max-retries = <0x0a>;
						qcom,ocp-retry-delay = <0x1e>;
						qcom,vs-soft-start-strength = <0x00>;
						regulator-initial-mode = <0x01>;
						phandle = <0x99>;
					};

					5vs2 {
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-pull-down;
						regulator-over-current-protection;
						qcom,ocp-max-retries = <0x0a>;
						qcom,ocp-retry-delay = <0x1e>;
						qcom,vs-soft-start-strength = <0x00>;
						regulator-initial-mode = <0x01>;
					};
				};
			};
		};

		dma-controller@fc834000 {
			compatible = "qcom,bam-v1.4.0";
			reg = <0xfc834000 0x7000>;
			interrupts = <0x00 0x1d 0x04>;
			#dma-cells = <0x01>;
			qcom,ee = <0x00>;
			num-channels = <0x06>;
			qcom,num-ees = <0x01>;
			qcom,powered-remotely;
			phandle = <0xa6>;
