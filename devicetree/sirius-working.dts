					type = "hot";
				};
			};
		};

		wlan-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0xb8 0x04>;

			trips {

				trip-point0 {
					temperature = <0x19a28>;
