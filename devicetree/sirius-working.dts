		clock-controller@fd8c0000 {
			compatible = "qcom,mmcc-msm8974";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			reg = <0xfd8c0000 0x6000>;
			clocks = <0x13 0x0d 0x110 0x0d 0x01 0x0d 0x0d 0x49 0x20 0xa7 0x01 0xa7 0x00 0xa8 0x01 0xa8 0x00 0x00 0x00 0x00>;
			clock-names = "xo", "mmss_gpll0_vote", "gpll0_vote", "gpll1_vote", "gfx3d_clk_src", "dsi0pll", "dsi0pllbyte", "dsi1pll", "dsi1pllbyte", "hdmipll", "edp_link_clk", "edp_vco_div";
			phandle = <0x64>;
		};

		display-subsystem@fd900000 {
			compatible = "qcom,mdss";
			reg = <0xfd900000 0x100 0xfd924000 0x1000>;
			reg-names = "mdss_phys", "vbif_phys";
			power-domains = <0x64 0x01>;
			clocks = <0x64 0x5d 0x64 0x5e 0x64 0x6d>;
			clock-names = "iface", "bus", "vsync";
			interrupts = <0x00 0x48 0x04>;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			phandle = <0xa9>;

			display-controller@fd900000 {
				compatible = "qcom,msm8974-mdp5", "qcom,mdp5";
				reg = <0xfd900100 0x22000>;
				reg-names = "mdp_phys";
				interrupt-parent = <0xa9>;
				interrupts = <0x00>;
				clocks = <0x64 0x5d 0x64 0x5e 0x64 0x69 0x64 0x6d>;
				clock-names = "iface", "bus", "core", "vsync";
				interconnects = <0xaa 0x02 0xab 0x05>;
				interconnect-names = "mdp0-mem";

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0xac>;
							phandle = <0xae>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0xad>;
							phandle = <0xaf>;
						};
					};
				};
			};

			dsi@fd922800 {
				compatible = "qcom,msm8974-dsi-ctrl", "qcom,mdss-dsi-ctrl";
				reg = <0xfd922800 0x1f8>;
				reg-names = "dsi_ctrl";
