	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x04 0xf08 0x01 0x01 0xf08>;
		clock-frequency = <0x124f800>;
	};

	aliases {
		mmc0 = "/soc/mmc@f9824900";
		mmc1 = "/soc/mmc@f98a4900";
		serial0 = "/soc/serial@f991e000";
		serial1 = "/soc/serial@f995d000";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0xbb>;
		pinctrl-names = "default";

		key-volume-down {
			label = "volume_down";
			gpios = <0x9a 0x02 0x01>;
			linux,code = <0x72>;
			debounce-interval = <0x0f>;
		};

		key-volume-up {
			label = "volume_up";
			gpios = <0x9a 0x05 0x01>;
			linux,code = <0x73>;
			debounce-interval = <0x0f>;
		};

		key-camera-snapshot {
			label = "camera_snapshot";
			gpios = <0x9a 0x03 0x01>;
			linux,code = <0xd4>;
			debounce-interval = <0x0f>;
		};

		key-camera-focus {
			label = "camera_focus";
			gpios = <0x9a 0x04 0x01>;
			linux,code = <0x210>;
			debounce-interval = <0x0f>;
		};
	};

	battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <0x30d400>;
		voltage-max-design-microvolt = <0x426030>;
		charge-full-design-microamp-hours = <0x30d400>;
		ocv-capacity-celsius = <0x19>;
		ocv-capacity-table-0 = <0x426030 0x64>, <0x4175d0 0x5f>, <0x40b280 0x5a>, <0x3fef30 0x55>, <0x3f2be0 0x50>, <0x3e6890 0x4b>, <0x3da540 0x46>, <0x3ce1f0 0x41>, <0x3c45b0 0x3c>, <0x3ba970 0x37>, <0x3b0d30 0x32>, <0x3a9800 0x2d>, <0x3a49e0 0x28>, <0x39fbc0 0x23>, <0x39ada0 0x1e>, <0x395f80 0x19>, <0x391160 0x14>, <0x389c30 0xf>, <0x382700 0xa>, <0x373ca0 0x5>, <0x33e140 0x0>;
		phandle = <0xc9>;
	};

	fuel-gauge {
		compatible = "adc-battery";
		io-channels = <0x9c 0x06>;
		io-channel-names = "voltage";
		monitored-battery = <0xc9>;
	};

	lcd-dcdc-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vreg_vsp";
		regulator-min-microvolt = "", "Us";
		regulator-max-microvolt = "", "Us";
		gpio = <0x9a 0x14 0x00>;
		enable-active-high;
		pinctrl-0 = <0xbc>;
		pinctrl-names = "default";
		phandle = <0xc4>;
	};

	vreg-boost {
		compatible = "regulator-fixed";
		regulator-name = "vreg-boost";
		regulator-min-microvolt = <0x3010b0>;
		regulator-max-microvolt = <0x3010b0>;
		regulator-always-on;
		regulator-boot-on;
		gpio = <0x9a 0x15 0x00>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <0xbd>;
		phandle = <0x18>;
	};

	vreg-vph-pwr {
		compatible = "regulator-fixed";
		regulator-name = "vph-pwr";
		regulator-min-microvolt = <0x36ee80>;
		regulator-max-microvolt = <0x36ee80>;
		regulator-always-on;
	};

	wlan-regulator {
		compatible = "regulator-fixed";
		regulator-name = "wl-reg";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x9a 0x12 0x00>;
		enable-active-high;
		pinctrl-0 = <0xbe>;
		pinctrl-names = "default";
		phandle = <0x20>;
	};
};
