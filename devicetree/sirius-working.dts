				num_sensor_y = <34>;
				button_code0 = <0>;
				button_code1 = <0>;
				button_code2 = <0>;
				button_code3 = <0>;
				touch_pressure_enabled = <1>;
				touch_size_enabled = <0>;
				touch_orientation_enabled = <0>;
				glove_enabled = <0>;
				report_pen_as_finger = <1>;
				wakeup_gesture_support = <1>;
				wakeup_gesture_timeout = <2000>;
				wakeup_gesture {
					double_tap {
						gesture_code = <0x0102>;
						event_00 {
							type = <2>; /* LOG */
							message = "=== DOUBLE TAP ===";
						};
						event_01 {
							type = <1>; /* KEY */
							code = <116>; /* KEY_POWER */
							down = <1>;
						};
						event_02 {
							type = <1>; /* KEY */
							code = <116>; /* KEY_POWER */
							down = <0>;
						};
						event_03 {
							type = <99>; /* END */
						};
					};
				};
			};
		};

