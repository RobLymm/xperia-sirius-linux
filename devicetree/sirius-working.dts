		remoteproc@fc880000 {
			compatible = "qcom,msm8974-mss-pil";
			reg = <0xfc880000 0x100 0xfc820000 0x20>;
			reg-names = "qdsp6", "rmb";
			interrupts-extended = <0x01 0x00 0x18 0x01 0x9e 0x00 0x01 0x9e 0x01 0x01 0x9e 0x02 0x01 0x9e 0x03 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
			clocks = <0x0d 0xb4 0x0d 0xb3 0x0d 0x8b 0x13>;
			clock-names = "iface", "bus", "mem", "xo";
			resets = <0x0d 0x4a>;
			reset-names = "mss_restart";
			power-domains = <0x47 0x00>;
			power-domain-names = "cx";
			qcom,halt-regs = <0x1b 0x1180 0x1200 0x1280>;
			qcom,smem-states = <0x9f 0x00>;
			qcom,smem-state-names = "stop";
			status = "okay";
			mss-supply = <0xa0>;
			mx-supply = <0xa1>;
			pll-supply = <0xa2>;

			mba {
				memory-region = <0xa3>;
			};

			mpss {
				memory-region = <0xa4>;
			};

			bam-dmux {
				compatible = "qcom,bam-dmux";
				interrupt-parent = <0xa5>;
				interrupts = <0x01 0x03 0x0b 0x03>;
				interrupt-names = "pc", "pc-ack";
				qcom,smem-states = <0x4b 0x01 0x4b 0x0b>;
				qcom,smem-state-names = "pc", "pc-ack";
				dmas = <0xa6 0x04 0xa6 0x05>;
				dma-names = "tx", "rx";
			};

			smd-edge {
				interrupts = <0x00 0x19 0x01>;
				mboxes = <0x12 0x0c>;
				qcom,smd-edge = <0x00>;
				label = "modem";
			};
		};

		hwlock@fd484000 {
			compatible = "qcom,msm8974-tcsr-mutex", "qcom,tcsr-mutex", "syscon";
