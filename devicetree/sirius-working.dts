				assigned-clocks = <0x64 0x21 0x64 0x13>;
				assigned-clock-parents = <0xa7 0x00 0xa7 0x01>;
				clocks = <0x64 0x69 0x64 0x5d 0x64 0x5e 0x64 0x5f 0x64 0x6b 0x64 0x64 0x64 0x6e>;
				clock-names = "mdp_core", "iface", "bus", "byte", "pixel", "core", "core_mmss";
				phys = <0xa7>;
				status = "okay";
				vdda-supply = <0xc2>;
				vdd-supply = <0xc3>;
				vddio-supply = <0xa2>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0xae>;
							phandle = <0xac>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0xc8>;
							data-lanes = <0x00 0x01 0x02 0x03>;
							phandle = <0xc7>;
						};
					};
				};

				panel@0 {
					compatible = "sony,sirius-panel";
					reg = <0x00>;
					vddio-supply = <0xc3>;
					vsp-supply = <0xc4>;
					reset-gpios = <0x9a 0x13 0x01>;
					backlight = <0xc5>;
					pinctrl-0 = <0xc6>;
