			reg-names = "kgsl_3d0_reg_memory";
			interrupts = <0x00 0x21 0x04>;
			interrupt-names = "kgsl_3d0_irq";
			clocks = <0x64 0x77 0x64 0x78 0x64 0x79>;
			clock-names = "core", "iface", "mem_iface";
			sram = <0xb2>;
			power-domains = <0x64 0x05>;
			operating-points-v2 = <0xb3>;
			interconnects = <0xaa 0x00 0xab 0x05 0xb4 0x0a 0xb4 0x0b>;
			interconnect-names = "gfx-mem", "ocmem";
			status = "okay";

			opp-table {
				compatible = "operating-points-v2";
				phandle = <0xb3>;

				opp-320000000 {
					opp-hz = <0x00 0x1312d000>;
				};

				opp-200000000 {
					opp-hz = <0x00 0xbebc200>;
				};

				opp-27000000 {
					opp-hz = <0x00 0x19bfcc0>;
				};
			};
		};

		sram@fdd00000 {
			compatible = "qcom,msm8974-ocmem";
			reg = <0xfdd00000 0x2000 0xfec00000 0x180000>;
			reg-names = "ctrl", "mem";
			ranges = <0x00 0xfec00000 0x180000>;
			clocks = <0x49 0x22 0x64 0x74>;
			clock-names = "core", "iface";
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			gmu-sram@0 {
				reg = <0x00 0x100000>;
				phandle = <0xb2>;
			};
		};

		remoteproc@fe200000 {
			compatible = "qcom,msm8974-adsp-pil";
			reg = <0xfe200000 0x100>;
			interrupts-extended = <0x01 0x00 0xa2 0x01 0xb5 0x00 0x01 0xb5 0x01 0x01 0xb5 0x02 0x01 0xb5 0x03 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
			clocks = <0x13>;
			clock-names = "xo";
			power-domains = <0x47 0x00>;
			power-domain-names = "cx";
			memory-region = <0xb6>;
			qcom,smem-states = <0xb7 0x00>;
			qcom,smem-state-names = "stop";
			status = "okay";

			smd-edge {
				interrupts = <0x00 0x9c 0x01>;
				mboxes = <0x12 0x08>;
				qcom,smd-edge = <0x01>;
				label = "lpass";
				apr {
					compatible = "qcom,apr-v2";
					qcom,smd-channels = "apr_audio_svc";
					qcom,domain = <0x04>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					service@3 {
						compatible = "qcom,q6core";
						reg = <0x03>;
					};

					service@4 {
						compatible = "qcom,q6afe";
						reg = <0x04>;

						dais {
							compatible = "qcom,q6afe-dais";
							#address-cells = <0x01>;
							#size-cells = <0x00>;
							#sound-dai-cells = <0x01>;
							phandle = <0xca>;

							dai@22 {
								reg = <0x16>;
								qcom,sd-lines = <0x00>;
							};
						};
					};

					service@7 {
						compatible = "qcom,q6asm";
						reg = <0x07>;

						dais {
							compatible = "qcom,q6asm-dais";
							#address-cells = <0x01>;
							#size-cells = <0x00>;
							#sound-dai-cells = <0x01>;
							phandle = <0xcb>;

							dai@0 {
								reg = <0x00>;
							};
						};
					};

					service@8 {
						compatible = "qcom,q6adm";
						reg = <0x08>;

						routing {
							compatible = "qcom,q6adm-routing";
							#sound-dai-cells = <0x00>;
							phandle = <0xcc>;
						};
					};
				};
			};
		};

		sound@fe02f000 {
			compatible = "qcom,msm8974-sndcard";
			reg = <0xfe02f000 0x04>;
			reg-names = "lpaif_quat_mode_muxsel";
			model = "Sony Xperia Z2";
			pinctrl-names = "default";
			pinctrl-0 = <0xcf>;

			mm1-dai-link {
				link-name = "MultiMedia1";

				cpu {
					sound-dai = <0xcb 0x00>;
				};
			};

			quat-mi2s-dai-link {
				link-name = "Quaternary MI2S Playback";

				cpu {
					sound-dai = <0xca 0x16>;
				};

				platform {
					sound-dai = <0xcc>;
				};

				codec {
					sound-dai = <0xcd 0xce>;
				};
			};
		};
		sram@fe805000 {
			compatible = "qcom,msm8974-imem", "syscon", "simple-mfd";
			reg = <0xfe805000 0x1000>;

			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x65c>;
			};
		};
	};

	thermal-zones {

		cpu0-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0xb8 0x05>;

			trips {

				trip0 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};

		cpu1-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0xb8 0x06>;

			trips {

				trip0 {
